
# ALFRESCO REPOSITORY
REPOSITORY_IMAGE=alfresco/alfresco-enterprise-repo-for-share
REPOSITORY_TAG=latest
REPOSITORY_PORT=8080

# SHARE IMAGE
SHARE_IMAGE=alfresco/alfresco-share-base
SHARE_TAG=latest
SHARE_PORT=8080

#POSTGRES IMAGE
POSTGRES_IMAGE=postgres
POSTGRES_TAG=14.4
POSTGRES_PORT=5432

#SOLR - SEARCH SERVICES IMAGE
SOLR_IMAGE=alfresco/alfresco-search-services
SOLR_TAG=2.0.23
SOLR_PORT=8983

#ELASTICSEARCH IMAGE
ELASTICSEARCH_IMAGE=elasticsearch
ELASTICSEARCH_TAG=8.17.10
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300

ACTIVEMQ_IMAGE=alfresco/alfresco-activemq
ACTIVEMQ_TAG=5.18.2-jre17-rockylinux8
TRANSFORMERS_TAG=5.4.5
TRANSFORM_ROUTER_TAG=4.4.5
SFS_TAG=4.4.5

# Kibana (optional, for Elasticsearch UI)
KIBANA_IMAGE=kibana
KIBANA_TAG=8.17.10
KIBANA_PORT=5601

# Alfresco Elasticsearch Search Services images/tags
ELASTICSEARCH_LIVE_INDEXING_IMAGE=quay.io/alfresco/alfresco-elasticsearch-live-indexing
ELASTICSEARCH_LIVE_INDEXING_TAG=5.5.0
ELASTICSEARCH_REINDEXING_IMAGE=quay.io/alfresco/alfresco-elasticsearch-reindexing
ELASTICSEARCH_REINDEXING_TAG=5.5.0

# Digital Workspace
DIGITAL_WORKSPACE_IMAGE=quay.io/alfresco/alfresco-digital-workspace
DIGITAL_WORKSPACE_TAG=7.4.0-23946109873

# Control Center
CONTROL_CENTER_IMAGE=quay.io/alfresco/alfresco-control-center
CONTROL_CENTER_TAG=10.2.0

# Proxy (Nginx)
PROXY_IMAGE=alfresco/alfresco-acs-nginx
PROXY_TAG=3.3.0

# Sync Service
SYNC_SERVICE_IMAGE=quay.io/alfresco/service-sync
SYNC_SERVICE_TAG=5.3.0
