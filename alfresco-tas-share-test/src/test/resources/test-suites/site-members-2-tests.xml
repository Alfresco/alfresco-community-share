<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Site Members Tests 2" parallel="classes" thread-count="2">
   <listeners>
      <listener class-name="org.alfresco.share.RetryListener"/>
   </listeners>

   <test name="Site Members Tests 2">
      <groups>
         <run>
            <include name="sites"/>
         </run>
      </groups>
      <classes>
         <class name="org.alfresco.share.site.members.AddSiteGroupsTest"/>
         <class name="org.alfresco.share.site.members.BecomeSiteManagerTest"/>
         <class name="org.alfresco.share.site.members.RequestSiteAccessTests"/>
         <class name="org.alfresco.share.site.members.ChangeSiteRoleTests"/>
      </classes>
   </test>

</suite>
